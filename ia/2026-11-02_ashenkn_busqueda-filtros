<!-- Componente de Búsqueda y Botón Desplegable de Filtros -->
<div class="relative w-1/2 md:w-48" @click.away="dropdownAbierto = false">
    <button 
        @click="dropdownAbierto = !dropdownAbierto" 
        class="w-full bg-[#1F113A] border border-white/10 rounded-lg px-4 py-2 text-white flex justify-between items-center hover:border-[#E99415] transition">
        <span x-text="categoria === 'todos' ? 'Categoría: Todas' : 'Categoría: ' + categoria.charAt(0).toUpperCase() + categoria.slice(1)"></span>
        <span class="text-xs ml-2">▼</span>
    </button>

    <!-- Menú Flotante Desplegable -->
    <div 
        x-show="dropdownAbierto" 
        class="absolute left-0 mt-2 w-full bg-[#0D0C1E] border border-white/10 rounded-lg shadow-xl z-20 overflow-hidden py-1">
        
        <button 
            @click="categoria = 'todos'; dropdownAbierto = false" 
            class="w-full text-left px-4 py-2 text-sm hover:bg-[#E99415] hover:text-black transition"
            :class="categoria === 'todos' ? 'text-[#F0C32C] font-bold' : 'text-white'">
            Todas las categorías
        </button>
        <button 
            @click="categoria = 'cartas'; dropdownAbierto = false" 
            class="w-full text-left px-4 py-2 text-sm hover:bg-[#E99415] hover:text-black transition"
            :class="categoria === 'cartas' ? 'text-[#F0C32C] font-bold' : 'text-white'">
            Cartas
        </button>
    </div>
</div>
